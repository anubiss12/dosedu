# Copy this to .env and fill in real values before running docker compose.
# Never commit the real .env file to git.

POSTGRES_USER=dosedu
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=dosedu

REDIS_PASSWORD=change_me_strong_password

# 32+ random bytes, e.g. `openssl rand -hex 32`
JWT_SECRET=change_me_to_a_long_random_secret

TELEGRAM_BOT_TOKEN=
# Random string; also pass this as secret_token when calling Telegram's
# setWebhook so it's echoed back on every incoming update.
TELEGRAM_WEBHOOK_SECRET=change_me_random_string

# Used by certbot for wildcard cert issuance / renewal notices
LETSENCRYPT_EMAIL=admin@dosedu.kz

# Optional — powers the student quiz "explain my mistake" AI hint.
# Leave empty to disable (UI shows a "coming soon" placeholder instead).
ANTHROPIC_API_KEY=

# Optional — super-admin System Health self-checks these two URLs.
# Leave empty to show "not_configured" instead of a false "down".
MAIN_SITE_URL=https://dosedu.kz
APP_SITE_URL=https://app.dosedu.kz
